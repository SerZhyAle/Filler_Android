{
  "version": "1",
  "projectName": "filler_mob",
  "envPrefix": "SZA",
  "modules": { "default": "phone", "names": ["phone"] },
  "locks": {
    "domains": [
      { "name": "Build.Main", "type": "Build", "rank": 1 },
      { "name": "Code.Main", "type": "Code", "rank": 2 },
      { "name": "Code.Scripts", "type": "Code", "rank": 3 }
    ],
    "pathRules": [
      { "pattern": "^PLAN/", "domain": null },
      { "pattern": "^(phone/|buildSrc/|gradlew|settings\\.gradle\\.kts|build\\.gradle\\.kts|gradle\\.properties|gradle/)", "domain": "Code.Main" },
      { "pattern": "^(tools/|docs/|site/|\\.github/|AGENTS\\.md|CLAUDE\\.md|README\\.md|LICENSE|\\.sza-)", "domain": "Code.Scripts" }
    ]
  },
  "probes": { "enabled": true, "scanRoots": ["phone/src"], "sourceRoots": ["phone/src"] },
  "commands": { "statusCommands": {} }
}
