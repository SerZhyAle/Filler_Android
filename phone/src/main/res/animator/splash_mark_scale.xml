<?xml version="1.0" encoding="utf-8"?>
<!--
    FILLER-0062: the Filler mark settles into place, growing slightly to full size.
    Motion only, no alpha fade: the splash window closes when the app is ready, so an
    element starting from invisible can be missed on fast cold starts.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.82"
        android:valueTo="1.0"
        android:valueType="floatType"
        android:duration="380"
        android:interpolator="@android:interpolator/decelerate_quint" />
    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.82"
        android:valueTo="1.0"
        android:valueType="floatType"
        android:duration="380"
        android:interpolator="@android:interpolator/decelerate_quint" />
</set>
