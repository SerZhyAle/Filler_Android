<?xml version="1.0" encoding="utf-8"?>
<!-- One attempt in the history of the scheduled fill (S0025 criterion 5): when and where, how it ended, and a delay
     line when the system started it late. Focusable as one unit, so a screen reader or a D-pad reads it whole. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/filler_spacing_8"
    android:focusable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtHistoryHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <TextView
        android:id="@+id/txtHistoryResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <TextView
        android:id="@+id/txtHistoryLate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />
</LinearLayout>
