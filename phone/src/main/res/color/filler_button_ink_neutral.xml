<?xml version="1.0" encoding="utf-8"?>
<!-- The neutral ink of an ordinary button and of its glyph (BUTTONS section 3 rule 5: Cancel-type commands and ordinary
     buttons use the neutral treatment, never an error or accent hue): the on-surface role of the theme, muted to the
     Material disabled opacity while the button is disabled, so text and glyph mute together (rule 6). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="?attr/colorOnSurface" android:state_enabled="false" />
    <item android:color="?attr/colorOnSurface" />
</selector>
