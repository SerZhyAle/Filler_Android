<?xml version="1.0" encoding="utf-8"?>
<!-- Aligned with FastMediaSorter's blue Light/Dark base theme and six custom accent overlays (FILLER-0067;
     source app_v2/src/main/res/values/themes.xml). Deliberate differences:
     - keeps ThemeOverlay.Filler.MaterialAlertDialog (BUTTONS 2.2 rectangular text dialog answers, S0033 / FILLER-0067 Q2)
       instead of FastMediaSorter's green/pink dialog confirm/cancel buttons;
     - omits FastMediaSorter-only host attributes (launcher*, player controls, MaterialSwitch/overflow overrides);
     - Base.Theme.Filler is the parent of values-v31/themes.xml so API 31+ keeps both the branded splash screen
       (FILLER-0062) and the day/night blue brand palette. -->
<resources>
    <style name="Base.Theme.Filler" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnSurfaceVariant">#FF655E6A</item>
        <item name="android:textColorSecondary">#FF655E6A</item>
        <item name="colorOutline">#FF6F6875</item>
        <item name="colorOutlineVariant">#FF8A8391</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Filler.MaterialAlertDialog</item>
    </style>

    <style name="Theme.Filler" parent="Base.Theme.Filler" />

