    <!-- The dialog answers of every product dialog (BUTTONS 2.2 section 3 rules 2 and 4, section 8 rule 3; S0033).
         Material's overlay gives each answer a full pill with a one-line caption that is cut with an ellipsis, so each
         button-bar role points at the product answer style in styles.xml. Deliberate difference from the stock dialog;
         the record is docs/SPECIFICATION_UI_SIZE_PROFILE.md section 8. -->
    <style name="ThemeOverlay.Filler.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Filler.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Filler.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Filler.Button.Dialog.Flush</item>
    </style>

    <!-- The window of the help layer (CONTEXT-HELP rule 6, S0028): full size over the live screen, its own scrim instead
         of the platform dim, so the screen stays visible under the markers. -->
    <style name="Theme.Filler.HelpLayer">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
    </style>
