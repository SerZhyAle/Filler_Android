<?xml version="1.0" encoding="utf-8"?>
<!-- The application icon (ICON-RENDER section 3 rule 9): the inherited FastMediaSorter Filler block over the
     product background, and the same glyph as the monochrome layer, so the themed icons of Android 13 and later
     show the block too (FILLER-0059). The foreground is white on transparent, an alpha-only silhouette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
